# Instagram feed (Instagram API with Instagram Login). Copy to .env.local and fill in.
# Without a token and with IG_MOCK off, the site simply shows no feed (fallback).

# From the Meta app dashboard: Instagram > API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=
# Must match a valid OAuth redirect URI in the Meta app settings
IG_REDIRECT_URI=https://polobrokers.com/api/ig/callback
# Long random string; guards /api/ig/connect?key=... and /api/ig/status?key=...
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IG_CONNECT_SECRET=
# Token, feed cache and media. VPS: /home/polobrokers/data   Local: ./.data
IG_DATA_DIR=./.data
# 1 = use the fixtures in tests/fixtures/ig (no Instagram call). Leave empty in production.
IG_MOCK=
